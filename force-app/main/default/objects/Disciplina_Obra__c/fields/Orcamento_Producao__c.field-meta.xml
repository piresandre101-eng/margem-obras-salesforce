<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Orcamento_Producao__c</fullName>
    <label>Orçamento de Produção</label>
    <description>Receita − impostos − margem: o que vira dias de produção.</description>
    <formula>Receita__c * (1 - Imposto_Pct__c - Meta_Margem_Pct__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <precision>18</precision>
    <scale>2</scale>
    <type>Currency</type>
</CustomField>
